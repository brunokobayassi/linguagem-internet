<%- include('../partials/header', { title }) %>

<section class="page-header">
  <div>
    <h1>Produtos</h1>
    <p>Exemplo simples de CRUD usando renderização MPA.</p>
  </div>

  <a class="button" href="/produtos/novo">Novo produto</a>
</section>

<div class="card">
  <% if (products.length === 0) { %>
    <p>Nenhum produto cadastrado.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nome</th>
          <th>Preço</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach((product) => { %>
          <tr>
            <td><%= product.id %></td>
            <td><%= product.name %></td>
            <td>
              R$ <%= Number(product.price).toLocaleString('pt-BR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
              }) %>
            </td>
            <td class="actions">
              <a class="button secondary" href="/produtos/<%= product.id %>/editar">
                Editar
              </a>

              <form
                method="post"
                action="/produtos/<%= product.id %>/excluir"
                onsubmit="return confirm('Excluir este produto?')"
              >
                <button class="button danger" type="submit">Excluir</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
